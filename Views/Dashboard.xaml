<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:ExamPortal.ViewModels"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             xmlns:circularChart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             xmlns:local="clr-namespace:ExamPortal"
             NavigationPage.HasBackButton="False"
             x:Class="ExamPortal.Dashboard"
             Style="{StaticResource RrPage}"
             Title="Dashboard">

    <ContentPage.BindingContext>
        <viewModels:DashboardViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">

            <Grid RowDefinitions="1*,1*,2*">

                <BoxView Grid.Row="0"
                     Grid.RowSpan="2"
                     BackgroundColor="{StaticResource RrPrimary}"
                     CornerRadius="0,0,20,20"/>

                <Label Grid.Row="0"
                        Text="Welcome"
                        FontSize="24"
                       Padding="10"
                FontAttributes="Bold"
                TextColor="{StaticResource RrCard}"
                HorizontalOptions="Start" />

                <VerticalStackLayout Spacing="10"
                                 Grid.Row="1"
                                 Padding="20"
                                 HeightRequest="150">

                    <!-- Upcoming Exams Section -->
                    <Label Text="Upcoming Exams"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#2D2D2D"/>

                    <CollectionView ItemsSource="{Binding UpcomingExams}"
                            HeightRequest="150">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame CornerRadius="12"
                                   Padding="15"
                                   HasShadow="True"
                                   WidthRequest = "310"
                                   Style="{StaticResource RrCardSecondary}">

                                    <VerticalStackLayout Spacing="10">
                                        <Label Text="{Binding Course}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource RrPrimary}"/>

                                        <Label Text="{Binding Subject}"
                                       FontSize="10"
                                       TextColor="{StaticResource RrText}"/>

                                        <Label Text="{Binding Date, StringFormat='Date: {0:MMM dd, yyyy}'}"
                                       FontSize="9"
                                       TextColor="{StaticResource RrPlaceholder}"/>

                                        <Label Text="{Binding Venue, StringFormat='Venue: {0}'}"
                                       FontSize="9"
                                       TextColor="{StaticResource RrPlaceholder}"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center">
                                <Label Text="No upcoming exams"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="#666666"/>

                                <Label Text="Check Later for new exams"
                                   FontSize="14"
                                   HorizontalOptions="Center"
                                   TextColor="#666666"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>

                <Grid Grid.Row="2"
                  RowDefinitions="1*,1*,1*,1*"
                  RowSpacing="15"
                  Margin="10,70,10,10">

                    <Label Grid.Row="0" 
                       Text="Performance Overview"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#2D2D2D"/>

                    <Grid Grid.Row="1"
                      ColumnDefinitions="*" 
                      RowDefinitions="Auto,Auto" 
                      ColumnSpacing="15" 
                      RowSpacing="15">

                        <!-- Pass/Fail Ratio -->
                        <Frame CornerRadius="12"
                           Padding="15"
                           HasShadow="True"
                           BorderColor="Transparent"
                           BackgroundColor="Transparent"
                           Grid.Row="0">

                            <VerticalStackLayout Spacing="10">
                                <Label Text="Students Status Distribution"
                                       TextDecorations="Underline"
                                       Style="{StaticResource RrPrimaryText}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Fill"/>

                                <circularChart:SfCircularChart HeightRequest="150"
                                                               HorizontalOptions="Start">
                                    <circularChart:SfCircularChart.Legend>
                                        
                                        <circularChart:ChartLegend Placement="Right" 
                                                                   ToggleSeriesVisibility="False">
                                            
                                            <circularChart:ChartLegend.ItemsLayout>
                                                <FlexLayout Wrap="Wrap"
                                                            WidthRequest="100"/>
                                            </circularChart:ChartLegend.ItemsLayout>
                                            
                                            <circularChart:ChartLegend.LabelStyle>
                                                <circularChart:ChartLegendLabelStyle FontSize="10"/>
                                            </circularChart:ChartLegend.LabelStyle>
                                            
                                        </circularChart:ChartLegend>
                                    </circularChart:SfCircularChart.Legend>

                                    <circularChart:PieSeries ItemsSource="{Binding PassFailDatas}"
                                                             XBindingPath="Category"
                                                             YBindingPath="Count"
                                                             ShowDataLabels="True"
                                                             Radius="1"
                                                             PaletteBrushes="{Binding CustomBrushes}">
                                        
                                        <circularChart:PieSeries.DataLabelSettings>
                                            <circularChart:CircularDataLabelSettings UseSeriesPalette="True"
                                                                                     LabelPosition="Inside"
                                                                                     LabelPlacement="Auto"/>
                                        </circularChart:PieSeries.DataLabelSettings>

                                    </circularChart:PieSeries>
                                </circularChart:SfCircularChart>


                                <Label Text="{Binding StudentPassRate, StringFormat='Pass Rate: {0}'}"
                                       FontSize="10"
                                       TextColor="{StaticResource RrSecondary}"
                                       HorizontalOptions="Center"
                                       Margin="0,10,0,0"/>
                            </VerticalStackLayout>
                        </Frame>


                        <!-- Performance Trend -->
                        <Frame CornerRadius="12"
                               Padding="15"
                               HasShadow="True"
                               BackgroundColor="#E1DEFF"
                               BorderColor="Transparent"
                               Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Course Performance"
                                       FontSize="12"
                                       Style="{StaticResource RrPrimaryText}"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>

                                <chart:SfCartesianChart HeightRequest="150">

                                    <chart:SfCartesianChart.XAxes>
                                        <chart:CategoryAxis LabelPlacement="BetweenTicks"
                                                            LabelsIntersectAction="Wrap"
                                                            ShowMajorGridLines="False"
                                                            LabelExtent="12">
                                        </chart:CategoryAxis>
                                    </chart:SfCartesianChart.XAxes>

                                    <chart:SfCartesianChart.YAxes>
                                        <chart:NumericalAxis Maximum="100"/>
                                    </chart:SfCartesianChart.YAxes>

                                    <chart:ColumnSeries ItemsSource="{Binding CoursePerformances}"
                                                XBindingPath="Course"
                                                YBindingPath="Percentage"
                                                Fill="{StaticResource RrCardDark}"
                                                Spacing="0.1"
                                                ShowDataLabels="True">
                                    </chart:ColumnSeries>

                                  
                                </chart:SfCartesianChart>


                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- Overall Statistics -->
                    <Frame Grid.Row="2" CornerRadius="12"
                           Padding="15"
                           HasShadow="True"
                           BorderColor="Transparent"
                           BackgroundColor="#E1DEFF">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                            <Label Text="Overall Institute Performance"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   Style="{StaticResource RrPrimaryText}"
                                   Grid.ColumnSpan="2"
                                   HorizontalOptions="Center"/>

                            <Label Text="{Binding OverallPercentage, StringFormat='Average: {0:F2}%'}"
                                   FontSize="10"
                                   TextColor="{StaticResource RrPrimary}"
                                   Grid.Column="0" Grid.Row="1"/>

                            <Label Text="{Binding OverallGrade, StringFormat='Grade: {0}'}"
                                   FontSize="10"
                                   TextColor="{StaticResource RrPrimary}"
                                   Grid.Column="1" Grid.Row="1"/>

                            <Label Text="{Binding TotalExams, StringFormat='Exams Taken: {0}'}"
                                   TextColor="{StaticResource RrPrimary}"
                                   FontSize="10"
                                   Grid.Column="0" Grid.Row="2"/>

                            <Label Text="{Binding PassRate, StringFormat='Pass Rate: {0}'}"
                                   FontSize="10"
                                   TextColor="{StaticResource RrPrimary}"
                                   Grid.Column="1" Grid.Row="2"/>
                        </Grid>
                    </Frame>
                </Grid>
                
            </Grid>

        </ScrollView>
        
        <local:ProfilePage />

        <Grid Grid.Row="1" 
              ColumnDefinitions="*, *, *, *, *"  
              ColumnSpacing="15" 
              Padding="5"
              BackgroundColor="{StaticResource RrPrimary}">


            <ImageButton Source="homefill.png"
                         Command="{Binding NavigateToDashboardCommand}"
                         HeightRequest="10"
                         Grid.Column="0"/>

            <ImageButton Source="calendar.png"
                         Command="{Binding NavigateToCalendarCommand}"
                         HeightRequest="10"
                         Grid.Column="1" />

            <ImageButton Source="marksheet.png"
                         Command="{Binding NavigateToResultSummaryCommand}"
                         HeightRequest="10"
                         Grid.Column="2" />

            
            <ImageButton Source="list.png"
                        Command="{Binding NavigateToTimeTableCommand}"
                        CornerRadius="8"
                        BackgroundColor="{StaticResource RrPrimary}"
                        HeightRequest="10"
                        Grid.Column="3"/>

            <ImageButton Source="user.png"
                         Command="{Binding ShowProfileCommand}"
                         CornerRadius="30"
                         HeightRequest="10"
                         Grid.Column="4" />

        </Grid>
    </Grid>
</ContentPage>